<?xml version="1.0"?>
<!--
  AEMS Test World — custom 4-room environment for AEMS project
  Targeting: Gazebo Harmonic (gz-sim8) / ROS 2 Jazzy

  Layout (top-down, all dims in metres):
  ┌───────────────┬───────────────┐
  │               │               │
  │  ROOM 1 (NW)  │  ROOM 2 (NE)  │
  │  Robot spawn  │  Red cylinder │
  │               ╽               │
  ├───────╼   ╾───┼───╼   ╾───────┤
  │               │               │
  │  ROOM 3 (SW)  │  ROOM 4 (SE)  │
  │  Blue box     │  Yellow bin   │
  │               │               │
  └───────────────┴───────────────┘

  Rooms: 2.5 m × 2.5 m interior each
  Wall thickness: 0.15 m,  Wall height: 2.5 m
  Doorways: 0.9 m wide
  Total footprint: 5.45 m × 5.45 m

  Outer boundary: x ∈ [-2.725, 2.725], y ∈ [-2.725, 2.725]
  Room centres:
    NW (-1.25,  1.25)   NE (1.25,  1.25)
    SW (-1.25, -1.25)   SE (1.25, -1.25)

  Doorways (0.9 m, centred on room-centre lines):
    NW↔NE  vertical wall x=0: y = [0.80, 1.70]
    SW↔SE  vertical wall x=0: y = [-1.70, -0.80]
    NW↔SW  horizontal wall y=0: x = [-1.70, -0.80]
    NE↔SE  horizontal wall y=0: x = [0.80, 1.70]
-->
<sdf version="1.8">
  <world name="aems_test_world">

    <!-- ── Gazebo Harmonic system plugins ────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ── Top-down camera (easier for SLAM monitoring) ─────────────── -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 12 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ── Lighting ─────────────────────────────────────────────────── -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.3 0.3 0.3 1</background>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.5 0.5 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- ── Ground plane ─────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         OUTER WALLS
         ================================================================ -->

    <!-- North outer wall  y=2.725, full width 5.45m -->
    <model name="wall_outer_north">
      <static>true</static>
      <pose>0 2.725 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5.45 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.45 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South outer wall  y=-2.725 -->
    <model name="wall_outer_south">
      <static>true</static>
      <pose>0 -2.725 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5.45 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.45 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West outer wall  x=-2.725 -->
    <model name="wall_outer_west">
      <static>true</static>
      <pose>-2.725 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 5.45 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 5.45 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East outer wall  x=2.725 -->
    <model name="wall_outer_east">
      <static>true</static>
      <pose>2.725 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 5.45 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 5.45 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         CENTRE VERTICAL WALL  (x=0, separates NW/NE and SW/SE rooms)
         Doorways:  NW↔NE at y=[0.80, 1.70]   SW↔SE at y=[-1.70, -0.80]
         Three solid segments remain:
           South: y=-2.65 to -1.70  → length=0.95, centre y=-2.175
           Mid  : y=-0.80 to  0.80  → length=1.60, centre y= 0
           North: y= 1.70 to  2.65  → length=0.95, centre y= 2.175
         ================================================================ -->

    <model name="wall_centre_v_south">
      <static>true</static>
      <pose>0 -2.175 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 0.95 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 0.95 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_centre_v_mid">
      <static>true</static>
      <pose>0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 1.60 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 1.60 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_centre_v_north">
      <static>true</static>
      <pose>0 2.175 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 0.95 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 0.95 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         CENTRE HORIZONTAL WALL  (y=0, separates NW/SW and NE/SE rooms)
         Doorways:  NW↔SW at x=[-1.70, -0.80]   NE↔SE at x=[0.80, 1.70]
         Three solid segments:
           West: x=-2.65 to -1.70  → length=0.95, centre x=-2.175
           Mid : x=-0.80 to  0.80  → length=1.60, centre x= 0
           East: x= 1.70 to  2.65  → length=0.95, centre x= 2.175
         ================================================================ -->

    <model name="wall_centre_h_west">
      <static>true</static>
      <pose>-2.175 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.95 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.95 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_centre_h_mid">
      <static>true</static>
      <pose>0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.60 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.60 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_centre_h_east">
      <static>true</static>
      <pose>2.175 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.95 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.95 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         ROOM LANDMARKS  (distinct coloured shapes for YOLO + navigation)
         ================================================================ -->

    <!-- ROOM 1 (NW) — No obstacle, just robot spawn.  Green floor marker -->
    <model name="marker_room1">
      <static>true</static>
      <pose>-1.25 1.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.0 0.8 0.0 1</ambient><diffuse>0.0 1.0 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROOM 2 (NE) — Tall red cylinder  ≈ "bottle" for YOLO -->
    <model name="landmark_bottle">
      <static>true</static>
      <pose>1.3 1.5 0.0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.07</radius><length>0.28</length></cylinder></geometry>
          <pose>0 0 0.14 0 0 0</pose>
        </collision>
        <visual name="vis">
          <pose>0 0 0.14 0 0 0</pose>
          <geometry><cylinder><radius>0.07</radius><length>0.28</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>1.0 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROOM 3 (SW) — Blue box  ≈ "box / crate" -->
    <model name="landmark_box">
      <static>true</static>
      <pose>-1.3 -1.5 0.0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <pose>0 0 0.2 0 0 0</pose>
        </collision>
        <visual name="vis">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <material><ambient>0.1 0.1 0.9 1</ambient><diffuse>0.1 0.1 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ROOM 4 (SE) — Yellow cylinder  ≈ "cup / bin" -->
    <model name="landmark_cup">
      <static>true</static>
      <pose>1.3 -1.5 0.0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.1</radius><length>0.22</length></cylinder></geometry>
          <pose>0 0 0.11 0 0 0</pose>
        </collision>
        <visual name="vis">
          <pose>0 0 0.11 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.22</length></cylinder></geometry>
          <material><ambient>0.9 0.8 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
